# ============================================================
#  Lua — arquivo de configuração (copie para .env e preencha)
#  NUNCA versione o .env real nem a pasta /session
# ============================================================

# ---- Identidade do bot ----
BOT_NAME=Lua
BOT_VERSION=1.0.0
AUTHOR_NAME=Lua Dev
# Prefixo dos comandos. Use BOT_PREFIX (e NÃO "PREFIX": no Termux essa variável
# já existe e aponta para o diretório do sistema, o que quebraria os comandos).
BOT_PREFIX=!
LANGUAGE=pt-BR
# Fuso horário usado pelos agendamentos (!horariogrupo). Nome IANA.
# Padrão: America/Sao_Paulo. Não depende do fuso do servidor.
BOT_TIMEZONE=America/Sao_Paulo

# ---- Dono (obrigatório) ----
# Número com DDI + DDD. Aceita vários formatos e vários números separados
# por vírgula: 5511999999999 | +55 (11) 99999-9999 | 5511999999999@s.whatsapp.net
# Pode usar um único dono (OWNER_NUMBER) ou vários donos (OWNER_NUMBERS, lista
# separada por vírgula). Ambos são combinados automaticamente.
OWNER_NUMBER=5511999999999
# OWNER_NUMBERS=5511999999999,5511988888888
OWNER_NAME=Dono

# ---- SEGURANÇA DE ENVIO (proteção contra restrição de conta) ----
# NOTA HONESTA: restrição de conta NÃO tem causa única, e não existe prova de
# que cards HTML / menu interativo causem banimento (vários bots usam isso sem
# cair). Por isso o padrão aqui é o comportamento NORMAL do bot: HTML, cards,
# menu por lista/botões e pagamento LIBERADOS.
#
# O que fica ligado é o FREIO DE RITMO (fila/intervalo/teto de mensagens e
# pausa automática ao ver sinal de restrição) — ele não muda conteúdo, só
# impede rajada — e o bloqueio de conversa fria no privado.
#
# Para investigar o SEU caso: node scripts/restricao.js  (lê os logs e mostra
# pareamentos, quedas, 429, ritmo e repetição de mensagens)

# MODO SEGURO (padrão: 0 = desligado). Ligue com 1 (ou `!freio seguro on`) para
# bloquear lista/botões nativos, cards HTML e teste de pagamento. Isso tira o
# menu com botões e os cards visuais — use só se quiser testar sem eles.
SAFE_MODE=0
#
# Overrides finos (vazio = segue o SAFE_MODE):
# ALLOW_INTERACTIVE=1   → libera menu por lista/botões nativos
# ALLOW_RICH_CARDS=1    → libera card HTML (ping2/tigrinho)
# ALLOW_PAYMENT_TEST=1  → libera !sp/!st
#
# FREIO DE ENVIO — fila única + intervalo + teto (todas as saídas do bot)
# Intervalo mínimo entre DOIS envios quaisquer (ms)
SEND_MIN_INTERVAL_MS=1200
# Intervalo mínimo por conversa (ms) — evita rajada no mesmo grupo
SEND_CHAT_INTERVAL_MS=2000
# Variação aleatória somada ao intervalo (deixa o ritmo não mecânico)
SEND_JITTER_MS=900
# Teto global de mensagens por minuto
SEND_MAX_PER_MINUTE=15
# Teto de mensagens por minuto na MESMA conversa
SEND_CHAT_MAX_PER_MINUTE=6
# Mídia (foto/vídeo/áudio/documento/sticker) espera N× mais que texto
SEND_MEDIA_MULTIPLIER=2
# WARMUP: número recém-pareado roda com limites ÷fator (0 = desliga o warmup;
# use 0 se o número já é antigo e aquecido, ou !freio warmup off)
SEND_WARMUP_HOURS=48
SEND_WARMUP_FACTOR=3
# Anti-broadcast: 0 = DESLIGADO (padrão). Com 3, a mesma mensagem idêntica só
# vai para 3 conversas em SEND_DUP_WINDOW_MIN minutos (o !broadcast é limitado).
# Com 1 a mesma mensagem não pode ir para dois chats diferentes na janela —
# era o que fazia o bot "fazer o comando e não responder" em alguns grupos.
SEND_DUP_MAX_CHATS=0
SEND_DUP_WINDOW_MIN=10
# Nunca abrir conversa no privado com quem nunca falou com o bot.
# No uso normal não muda nada (o bot responde, não inicia conversa).
SEND_BLOCK_COLD_PV=1
# PVs liberados sempre, mesmo sem histórico (além do dono). Ex.: 5511999999999
SEND_PV_ALLOW=
# Ao detectar sinal de restrição (429/"spam"), pausa TODOS os envios por N min
SEND_PAUSE_MINUTES=15
# Espera após (re)conectar antes do primeiro envio (ms) — evita rajada no boot
SEND_CONNECT_GRACE_MS=8000
# Teto de itens na fila por conversa (proteção contra fila infinita)
SEND_MAX_QUEUE_PER_CHAT=15
# PRAZO de um envio (ms). Se o envio não concluir nesse tempo, ele é considerado
# TRAVADO (não é erro: pode ter saído). O freio libera a fila, registra e reenvia
# UMA vez sem citação — sem isso, um envio pendurado travava TODAS as respostas
# (o bot ficava "digitando…" e nada aparecia no chat). 0 = sem prazo.
SEND_TIMEOUT_MS=45000
# Prazo do reenvio depois de um travamento (ms)
SEND_RETRY_TIMEOUT_MS=20000
# 1 = reenvia uma vez o envio que travou (sem citação e com metadados em cache)
SEND_RETRY_ON_HANG=1
# ---- INTERRUPTORES DE EMERGENCIA (isolar uma suspeita sem editar codigo) ----
# 1 = usa os caches protegidos novos (signal store + aparelhos por usuario).
# 0 = volta aos caches padrao da biblioteca (isola qualquer suspeita neles).
SAFE_CACHE=1
# 1 = metadados de grupo em cache (envio nao faz a consulta ao vivo que pode travar)
# 0 = volta a consulta ao vivo (isola o cache de metadados)
GROUP_META_CACHE=1

# ---- Metadados de grupo (e o que evita o envio travado em comunidade/LID) ----
# A biblioteca busca a lista de participantes do grupo AO VIVO e SEM PRAZO ao
# enviar; se o servidor não responde, o envio fica pendurado para sempre. Com o
# cache abaixo o envio usa os metadados guardados e não faz essa consulta.
# Validade do cache (ms)
GROUP_META_TTL_MS=300000
# Prazo de uma busca de metadados (ms) — nunca deixa o envio esperando
GROUP_META_TIMEOUT_MS=12000
# 1 = aquece o cache na conexão (uma consulta para todos os grupos)
GROUP_META_WARM=1
# Pasta do estado do freio (warmup, contadores, PVs conhecidos, auditoria)
SEND_STATE_DIR=./data

# ---- Botões interativos ----
# true = !menu usa botões clicáveis reais; false = menu textual numerado.
# Pode ser alterado em runtime com !botao on / !botao off (persistido).
# (Só é afetado se você ligar SAFE_MODE=1.)
BUTTONS_ENABLED=true
# HTML PLAY: card visual opcional para Play/ytmp3/ytmp4 (true/false)
HTML_PLAY_ENABLED=false
HTML_PLAY_TEXT_FALLBACK=true

# ---- Número usado para o pairing code (opcional) ----
# Se deixado em branco, o bot pedirá o número no terminal ao iniciar.
PAIRING_NUMBER=

# ---- Versão do protocolo do WhatsApp (opcional) ----
# Normalmente deixe VAZIO: o bot busca a versão atual automaticamente.
# Se aparecer erro de conexão 405 ("client outdated"), fixe a versão aqui
# no formato "2,3000,1043857760" (consulte https://wppconnect.io/whatsapp-versions/).
WA_VERSION=

# ---- País padrão (ISO 2 letras) ----
# Usado para interpretar números digitados SEM DDI explícito (ex.: 19999999999).
# Pode ser alterado também no terminal (Configurações) ou via !config country XX.
DEFAULT_COUNTRY=BR

# ---- Modo de operação ----
# true = apenas dono + usuários registrados usam comandos (modo privado)
PRIVATE_MODE=false

# ---- Caminhos ----
SESSION_DIR=./session
DATABASE_FILE=./database/lua.db
MENU_IMAGE=./assets/menu.jpg

# ---- Menus com imagem (cada um cai no MENU_IMAGE se não existir) ----
MENU_IMAGE_ADMIN=./assets/admin.jpg
MENU_IMAGE_STICKER=./assets/sticker.jpg
MENU_IMAGE_RPG=./assets/rpg.jpg
MENU_IMAGE_DOWNLOAD=./assets/download.jpg
MENU_IMAGE_PROFILE=./assets/profile.jpg

# ---- "Ler mais" (mensagens longas recolhidas) ----
# true = ativado. Pode ser alterado em runtime com !lermais on/off.
LUA_READMORE=true

# ---- Limites ----
# DOWNLOAD_MAX_MB é o novo nome; MAX_DOWNLOAD_MB continua aceito (legado).
DOWNLOAD_MAX_MB=100
DOWNLOAD_TIMEOUT=90000
MAX_UPLOAD_MB=60
STICKER_MAX_MB=15
STICKER_MAX_SECONDS=10
DEFAULT_COOLDOWN_MS=3000

# ---- Downloaders — qualidade e velocidade (NOVO) ----
# Qualidade de vídeo YouTube: best (máxima que couber no limite), 2160, 1440, 1080, 720, 480, 360
YT_VIDEO_QUALITY=720
# Qualidade de áudio: best, 320k, 256k, 192k, 128k
YT_AUDIO_QUALITY=best
# Fragmentos concorrentes (yt-dlp) — 1 a 16, maior = download DASH mais rápido
YT_CONCURRENT_FRAGMENTS=8
# Qualidade de imagem: original, high, medium
IMAGE_QUALITY=high
# Tentativas de retry em caso de falha de rede
DOWNLOAD_RETRIES=3
# Usar aria2c se disponível (ainda mais rápido, opcional)
USE_ARIA2C=false
# Concorrência global de downloads (1 a 5)
MAX_CONCURRENT_DOWNLOADS=3
# Preferir yt-dlp sempre que disponível (mais rápido que ytdl-core)
PREFER_YTDLP=true
# Cookies do YouTube (opcional, mas é O conserto do erro
# "Sign in to confirm you are not a bot" em muitos vídeos).
# 1) navegador logado no YouTube → extensão "Get cookies.txt" → exporte
# 2) salve em ./cookies.txt e aponte aqui:
# YT_COOKIES=./cookies.txt
#
# MOTORES EXTERNOS (Termux) — sem eles o YouTube costuma falhar:
#   pkg install python ffmpeg && pip install -U yt-dlp
# Diagnóstico completo: node scripts/downloads-doctor.js

# ---- Lua Life (economia/simulador) ----
# Moeda virtual: símbolo e emoji exibidos (ex.: "🪙 1.000 LC")
LUA_COIN_SYMBOL=LC
LUA_COIN_EMOJI=🪙
# Início do personagem
LUA_START_MONEY=1000
LUA_START_ENERGY=100
LUA_ENERGY_MAX=200
# Limites econômicos (anti-exploit)
LUA_DAILY_BASE=250
LUA_DAILY_MAX=500
LUA_DAILY_STREAK_MAX=7
LUA_LOTTERY_MAX=500

# ---- Logs ----
LOG_LEVEL=info
LOG_TO_FILE=true

# ---- Recursos avançados (opcional) ----
# !eval é desabilitado por padrão. Habilite apenas se souber o que faz.
ENABLE_EVAL=false

# ---- APIs externas (opcionais) ----
# Deixe em branco para desabilitar o recurso correspondente.
OPENWEATHER_API_KEY=

# ---- IA (assistente) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_SYSTEM_PROMPT=
AI_MEMORY=true
AI_TIMEOUT=45000
AI_COOLDOWN=6000

# ---- Stickers ----
# Bio rica automática: packname/author com criador, origem (GP/PV), bot, dono, dev
# Templates opcionais — deixe vazio para geração automática rica
# Placeholders: {bot}, {creator}, {owner}, {dev}, {group}, {origin}, {date}
STICKER_PACKNAME=
STICKER_AUTHOR=
# Incluir data na bio do sticker (false = mais limpo)
STICKER_INCLUDE_DATE=false
# Ativar bio rica completa (recomendado: true)
STICKER_RICH_BIO=true
# No Termux/Android o sharp (conversor nativo) é ignorado por padrão, porque o
# binário dele é compilado para glibc e pode DERRUBAR o processo. Se você
# compilou o sharp do zero no Termux (pkg install libvips + build-from-source)
# e quer usar, defina 1. Senão o bot usa ffmpeg + node-webpmux (wasm), que já
# fazem stickers normalmente.
# LUA_ALLOW_SHARP=1


# ---- Interface / identidade visual (LUA) ----
# Tema do bot (config/themes.js). Em runtime pode ser trocado com !tema <preset> (dono).
# Presets: LUA_NIGHT, LUA_VIOLET, LUA_GALAXY, LUA_MYSTIC, LUA_ECLIPSE,
#          LUA_COSMIC, LUA_ROYAL, LUA_LAVENDER, LUA_NEON, LUA_AMOLED
LUA_THEME=LUA_NIGHT
# Modo de menu: text | buttons | auto (auto = decide pelo suporte/navegação)
LUA_UI_MODE=auto
# Proteção global contra flood de mensagens (recomendado: 1)
ANTI_FLOOD=1
# Cache em memória (metadados, fotos, configs) — recomendado: 1
LUA_CACHE=1
# Log de debug extra (não expõe credenciais)
DEBUG=0
# Métricas internas (usadas pelo !debug)
LUA_METRICS=1

# ---- Camada humana (anti-ban: comportamento de pessoa, não de script) ----
# Simula presença humana antes de responder (envia "digitando..." e espera o
# tempo proporcional ao texto). Não muda o conteúdo, só o ritmo/reação.
HUMAN_DELAYS=true
MIN_TYPING_DELAY_MS=600
MAX_TYPING_DELAY_MS=2200
# Intervalo mínimo entre envios — usado SÓ com ANTI_BAN_OWN_QUEUE=1.
# No uso normal quem controla o ritmo é SEND_MIN_INTERVAL_MS (freio de envio).
OUTBOUND_INTERVAL_MS=1000
# Silenciador de PV: não responde conversa casual de desconhecido no privado
# (denúncia de estranho é uma das principais causas de ban).
SILENT_PV=true
# Assinatura de navegador do Baileys: windows (recomendado) | macos | ubuntu
BROWSER_NAME=windows
# Ficar online 24h contínuas (false = mais natural; true = risco de flag de bot)
MARK_ONLINE_ON_CONNECT=false
# (opcional) a fila de envio é a do freio — veja SEND_* no bloco de segurança.
# Defina ANTI_BAN_OWN_QUEUE=1 apenas se quiser uma fila extra (não recomendado).
# ANTI_BAN_OWN_QUEUE=1
